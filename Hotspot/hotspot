#!/usr/bin/env bash
# =============================================================================
# hotspot - low-latency 5 GHz Wi-Fi hotspot for VR game streaming
#
#   ./hotspot start <ssid> <password> [--internet=true|false] [--iface=NAME]
#                   [--usb-id=VVVV:PPPP|--pci-id=VVVV:DDDD]
#                   [--channel=N|auto] [--width=20|40|80]
#                   [--country=XX]
#   ./hotspot stop
#   ./hotspot status
#
# How it works (everything is runtime-only: `stop` or a reboot restores the host)
#   hostapd   runs the access point and attaches the adapter to the bridge
#   bridge    br-hotspot (iproute2) carries the host's gateway address
#   dnsmasq   DHCP on the bridge (+ DNS when the internet is shared)
#   nftables  one private table: NAT when sharing internet, isolation otherwise
#   firewalld if running, the bridge joins its "trusted" zone (runtime only)
#
# Host <-> headset game traffic is plain layer-2 traffic on the bridge; it never
# touches NAT. Radio settings (channel, width, HT/VHT/HE capabilities) are read
# from the adapter itself, so a different adapter needs no code changes.
#
# Requirements: bash 4.4+, hostapd (+ hostapd_cli), dnsmasq, ip (iproute2), iw,
# nft (nftables), flock + setsid (util-linux), coreutils. NM/firewalld are optional.
#
# Firewall note: firewalld is handled automatically (the bridge is placed in the
# "trusted" zone until `stop`; a `firewall-cmd --reload` drops that binding, so
# restart the hotspot after one). With any other host firewall that drops traffic
# arriving on the bridge, allow the bridge interface (default: br-hotspot) in it:
# another firewall's "drop" cannot be overridden from a separate nftables table.
# =============================================================================
# Ownership flags are consumed indirectly by restore()/save_state().
# shellcheck disable=SC2034
set -Eeuo pipefail
set +m                              # setsid must exec the child without forking
shopt -s nullglob
umask 077                           # configurations contain the Wi-Fi password
export LC_ALL=C
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

############################################################################
# CONFIGURATION - every tunable lives in this block
############################################################################

# --- Identity (./hotspot start <ssid> <password>) ---
SSID="VR-Hotspot"                    # used when the ssid argument is ""
# There is no default password: pass 8-63 characters (WPA2), or "" for an open network.

# --- Network ---
BRIDGE="br-hotspot"                  # bridge created for the hotspot
BRIDGE_IP="192.168.42.1"             # host address on the bridge (must be the first host address of CIDR)
CIDR="192.168.42.0/24"               # hotspot network; the DHCP pool is derived from it
LEASE_TIME="12h"
INTERNET=true                        # share the host's internet with clients (--internet=)

# --- Adapter ---
WIFI_IFACE=""                        # interface name; empty = find by PCI_ID or USB_ID (--iface=)
USB_ID="13b1:0045"                   # Linksys WUSB6300 v2 (--usb-id=)
PCI_ID=""                           # PCI vendor:device id; when set, overrides USB_ID (--pci-id=)

# --- Radio ---
COUNTRY_CODE=""                      # e.g. US; empty = keep the system's regulatory domain (--country=)
CHANNEL="auto"                       # auto = first fully usable non-DFS 5 GHz block (--channel=)
CHANNEL_WIDTH=80                     # 20, 40 or 80 MHz (--width=)
USE_WIFI6=true                       # use 802.11ax when the adapter supports it

# --- Escape hatches: raw lines appended to the generated configs ---
HOSTAPD_EXTRA=""
DNSMASQ_EXTRA=""

# --- Internals ---
STATE_DIR="/run/hotspot"             # runtime files; /run is cleared on reboot
NFT_TABLE="hotspot"                  # private nftables table (family inet)
LOCK_FILE="/run/hotspot.lock"        # serializes all commands; outside STATE_DIR on purpose
LOG_FILE="/run/hotspot.log"          # progress + hostapd + dnsmasq log; outside STATE_DIR so a failed
                                     # start leaves it behind; truncated by each start
AP_WAIT=20                          # seconds, excluding DFS radar checks
DFS_WAIT=660                        # includes the 10-minute weather-radar CAC
SERVICE_WAIT=10                     # seconds for DHCP/DNS and final readiness

# IEEE 802.11 capability bit -> hostapd flag (bit positions are fixed by the standard).
HT_BITS=(0:LDPC 5:SHORT-GI-20 6:SHORT-GI-40 7:TX-STBC 11:MAX-AMSDU-7935)
VHT_BITS=(0:MAX-MPDU-7991 1:MAX-MPDU-11454 4:RXLDPC 5:SHORT-GI-80 7:TX-STBC-2BY1)

############################################################################
# Helpers
############################################################################

SELF=$(readlink -f "${BASH_SOURCE[0]}")
STATE_FILE="$STATE_DIR/state"

# Values that stop/status need later; start saves them to $STATE_FILE.
PHY="" USB_DIR="" USB_POWER_PREV="" IP_FORWARD_PREV="" NM_MANAGED_PREV="" REG_PREV="" BRIDGE_OWNED="" NFT_OWNED=""
WIFI_OWNED="" WIFI_WAS_UP="" PREFIX="" START_ERROR="" FW_OWNED="" FW_ZONE_PREV="" STARTING_PID=""
STATE_VERSION=2
SAVED_VARS=(WIFI_IFACE BRIDGE BRIDGE_IP INTERNET USB_DIR USB_POWER_PREV IP_FORWARD_PREV
            NM_MANAGED_PREV REG_PREV BRIDGE_OWNED NFT_OWNED WIFI_OWNED WIFI_WAS_UP PREFIX
            FW_OWNED FW_ZONE_PREV STATE_VERSION NFT_TABLE)

die()  { echo "hotspot: $*" >&2; exit 1; }
log()  { printf '==> %s\n' "$*" >>"$LOG_FILE"; printf '==> %s\n' "$*"; }
need() { local c; for c; do command -v "$c" >/dev/null || die "required command not found: $c"; done; }

# retry N CMD...  run CMD until it succeeds, at most N times, 0.5 s apart
retry() { local n=$1; shift; until "$@"; do (( --n > 0 )) || return 1; sleep 0.5; done; }

# quiet CMD...  run CMD silently; show its output only if it fails
quiet() {
  local out rc
  out=$("$@" 2>&1) || {
    rc=$?
    printf '%s\n' "$out" >&2
    [[ ! -f $LOG_FILE ]] || printf '%s\n' "$out" >>"$LOG_FILE"
    return "$rc"
  }
}

to_bool() {
  case ${1,,} in
    1|true|yes|y|on)  echo 1 ;;
    0|false|no|n|off) echo 0 ;;
    *) die "not a boolean: '$1'" ;;
  esac
}

ip2int() {
  local a b c d octet
  [[ $1 =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
  IFS=. read -r a b c d <<<"$1"
  for octet in "$a" "$b" "$c" "$d"; do (( 10#$octet <= 255 )) || return 1; done
  echo $(( 10#$a << 24 | 10#$b << 16 | 10#$c << 8 | 10#$d ))
}
int2ip() { echo "$(( $1 >> 24 & 255 )).$(( $1 >> 16 & 255 )).$(( $1 >> 8 & 255 )).$(( $1 & 255 ))"; }

# bit_flags VALUE BIT:FLAG...  ->  "[FLAG][FLAG]" for every bit set in VALUE
bit_flags() {
  local value=$1 spec; shift
  for spec; do
    if (( value >> ${spec%%:*} & 1 )); then printf '[%s]' "${spec#*:}"; fi
  done
}

# stbc_flag N PREFIX  RX-STBC is a multi-bit field holding the max stream count N -> "[PREFIX12..N]"
stbc_flag() { local s=("" 1 12 123 1234); if (( $1 >= 1 && $1 <= 4 )); then printf '[%s%s]' "$2" "${s[$1]}"; fi; }

# write_file PATH  replace PATH with stdin atomically (temp file + rename), so a crash leaves either
# the old or the new content, never half a file. mktemp makes the file 0600.
write_file() {
  local tmp
  tmp=$(mktemp "$1.XXXXXX") || return 1
  if ! { cat >"$tmp" && mv -fT -- "$tmp" "$1"; }; then rm -f -- "$tmp"; return 1; fi
}

save_state() { local v; for v in "${SAVED_VARS[@]}"; do printf '%s=%q\n' "$v" "${!v}"; done | write_file "$STATE_FILE"; }

# Old versions also used shell assignments. Only source files protected by a
# trusted directory and ownership; never execute state writable by another user.
check_owned() {
  local owner mode
  [[ ! -L $1 ]] || die "refusing symlink: $1"
  [[ -e $1 ]] || return 0
  read -r owner mode < <(stat -c '%u %a' -- "$1")
  if [[ $owner != "$EUID" ]] || (( (8#$mode & 0022) != 0 )); then die "unsafe owner or permissions on $1"; fi
}

load_state() {
  check_owned "$STATE_DIR"
  check_owned "$STATE_FILE"
  if [[ -e $STATE_DIR && ! -f $STATE_FILE ]]; then die "missing recovery state: $STATE_FILE; inspect $STATE_DIR before removing it"; fi
  if [[ -r $STATE_FILE ]]; then
    STATE_VERSION=1
    # shellcheck source=/dev/null
    source "$STATE_FILE"
    if (( STATE_VERSION == 1 )); then WIFI_OWNED=$BRIDGE_OWNED; FW_OWNED=$BRIDGE_OWNED; fi
    STATE_VERSION=2
  fi
}

# alive PID  true if PID is running; a zombie (exited, not yet reaped by its parent) is not
alive() {
  local state
  state=$(awk '/^State:/ { print $2 }' "/proc/$1/status" 2>/dev/null) || return 1
  [[ -n $state && $state != [ZXx] ]]
}

# daemon_pid PIDFILE NAME  prints the pid if PIDFILE names a live process called NAME
daemon_pid() {
  local pid arg config found=0 ticks
  [[ -r $1 ]] || return 1
  pid=$(<"$1")
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
  [[ $(cat "/proc/$pid/comm" 2>/dev/null) == "$2" ]] && alive "$pid" || return 1
  config="${1%/*}/$2.conf"
  while IFS= read -r -d '' arg; do
    if [[ $arg == "$config" || $arg == "--conf-file=$config" ]]; then found=1; fi
  done <"/proc/$pid/cmdline" 2>/dev/null || return 1
  (( found )) || return 1
  if [[ -f $1.start ]]; then
    ticks=$(process_start "$pid") || return 1
    [[ $ticks == "$(<"$1.start")" ]] || return 1
  fi
  echo "$pid"
}

process_start() {
  local stat rest
  stat=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  rest=${stat##*) }                  # comm may itself contain spaces or ')'
  awk '{print $20}' <<<"$rest"       # field 22 in /proc/PID/stat
}

# Both daemons stay in the foreground in their own session. This gives us their
# real PID and captures even early stderr errors without hostapd's optional -f.
start_daemon() {
  local pidfile=$1 pid ticks; shift
  setsid -- "$@" </dev/null >>"$LOG_FILE" 2>&1 9>&- &
  pid=$!
  STARTING_PID=$pid
  printf '%s\n' "$pid" | write_file "$pidfile"
  ticks=$(process_start "$pid") || { echo "hotspot: ${pidfile##*/} exited during launch" >&2; return 1; }
  printf '%s\n' "$ticks" | write_file "$pidfile.start"
  STARTING_PID=""
}

stop_daemon() {
  local pid sig i
  pid=$(daemon_pid "$1" "$2") || return 0
  for sig in TERM KILL; do
    daemon_pid "$1" "$2" >/dev/null || return 0
    kill -s "$sig" "$pid" 2>/dev/null || true
    for i in {1..20}; do alive "$pid" || return 0; sleep 0.25; done
  done
  echo "hotspot: $2 (pid $pid) would not exit" >&2
  return 1
}

# attempt CMD...  run one cleanup step; if it fails, say so and carry on with the rest
attempt() { "$@" || { echo "hotspot: cleanup step failed: $*" >&2; CLEANUP_FAILED=1; }; }

# hostapd_enabled  true once hostapd reports the AP as ENABLED (not merely started)
hostapd_enabled() {
  daemon_pid "$STATE_DIR/hostapd.pid" hostapd >/dev/null || return 1
  local status
  status=$(timeout 2 hostapd_cli -p "$STATE_DIR/hostapd" -i "$WIFI_IFACE" status 2>/dev/null) || return 1
  [[ $'\n'$status$'\n' == *$'\nstate=ENABLED\n'* ]]
}

wait_for_ap() {
  local deadline=$(( SECONDS + $1 ))
  # Allow exec/initialization to finish, but fail promptly if the process exits.
  sleep 0.1
  while (( SECONDS < deadline )); do
    alive "$(<"$STATE_DIR/hostapd.pid")" || die "hostapd exited before the AP became ready"
    if hostapd_enabled; then return 0; fi
    sleep 0.5
  done
  die "access point did not become ENABLED within $1 seconds"
}

# nm_set DEV yes|no  set NetworkManager's managed flag and confirm NM acted on it
# (an unmanaged device is state "10 (unmanaged)"); hostapd must not start while NM still owns the adapter
nm_set() {
  nmcli device set "$1" managed "$2" >/dev/null 2>&1 || return 1
  [[ $(nmcli -g GENERAL.NM-MANAGED device show "$1" 2>/dev/null) == "$2" ]] || return 1
  [[ $2 == yes || $(nmcli -g GENERAL.STATE device show "$1" 2>/dev/null) == "10 "* ]]
}

# nm_managed yes|no IFACE...  hand IFACE to / take it from NetworkManager; no-op if NM is not running
nm_managed() {
  local state=$1 dev; shift
  command -v nmcli >/dev/null && [[ $(nmcli -g RUNNING general 2>/dev/null) == running ]] || return 0
  for dev; do
    if [[ -z $dev ]]; then continue; fi
    retry 10 nm_set "$dev" "$state" || { echo "hotspot: NetworkManager did not accept managed=$state for $dev" >&2; return 1; }
  done
}

# fw_zone change|remove  bind the bridge to firewalld's trusted zone (runtime only; no-op unless firewalld is running)
fw_zone() {
  command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1 || return 0
  if [[ $1 == change ]]; then
    FW_ZONE_PREV=$(firewall-cmd --get-zone-of-interface="$BRIDGE" 2>/dev/null || true)
    if [[ $FW_ZONE_PREV == "no zone" ]]; then FW_ZONE_PREV=""; fi
    FW_OWNED=1
    save_state || return 1
  elif [[ -n $FW_ZONE_PREV ]]; then
    quiet firewall-cmd "--zone=$FW_ZONE_PREV" "--change-interface=$BRIDGE"
    return
  fi
  # a `firewall-cmd --reload` already dropped the binding: nothing left to remove
  if [[ $1 == remove ]] && ! firewall-cmd --zone=trusted --query-interface="$BRIDGE" >/dev/null 2>&1; then return 0; fi
  quiet firewall-cmd --zone=trusted "--$1-interface=$BRIDGE"
}

require_root() {
  (( EUID == 0 )) && return 0
  command -v sudo >/dev/null || die "must be run as root (sudo not found)"
  exec sudo -- "$SELF" "$@"
}

############################################################################
# Adapter detection (sysfs + iw)
############################################################################

# usb_dir IFACE  sysfs directory of the USB device behind IFACE (empty if not USB)
usb_dir() {
  local dir
  dir=$(readlink -f "/sys/class/net/$1/device") || return 0
  while [[ $dir == /sys/?* ]]; do
    if [[ -r $dir/idVendor ]]; then echo "$dir"; return 0; fi
    dir=${dir%/*}
  done
}

usb_id() {
  local dir
  dir=$(usb_dir "$1")
  if [[ -n $dir ]]; then echo "$(<"$dir/idVendor"):$(<"$dir/idProduct")"; fi
}

pci_id() {
  local dir vendor device
  dir=$(readlink -f "/sys/class/net/$1/device") || return 0
  # Only the adapter itself may match, never a USB adapter's upstream PCI controller.
  [[ $(readlink -f "$dir/subsystem") == /sys/bus/pci ]] || return 0
  [[ -r $dir/vendor && -r $dir/device ]] || return 0
  vendor=$(<"$dir/vendor"); device=$(<"$dir/device")
  echo "${vendor#0x}:${device#0x}"
}

# wifi_ifaces  one "NAME USB_ID PCI_ID" line per wireless interface (- if unavailable)
wifi_ifaces() {
  local p name usb pci
  for p in /sys/class/net/*/phy80211; do
    name=${p%/phy80211}; name=${name##*/}
    usb=$(usb_id "$name"); pci=$(pci_id "$name")
    echo "$name ${usb:--} ${pci:--}"
  done
}

resolve_iface() {
  local bus=USB id=$USB_ID column=2
  if [[ -z $WIFI_IFACE ]]; then
    if [[ -n $PCI_ID ]]; then bus=PCI; id=$PCI_ID; column=3; fi
    WIFI_IFACE=$(wifi_ifaces | awk -v id="$id" -v column="$column" '$column == id && !found { print $1; found = 1 }')
    [[ -n $WIFI_IFACE ]] || die "no wireless interface with $bus id $id found (is its driver loaded?)
Wireless interfaces present (name, USB id, PCI id):
$(wifi_ifaces | sed 's/^/  /')
Pick one with --iface=NAME, --usb-id=VVVV:PPPP or --pci-id=VVVV:DDDD"
  fi
  [[ -e /sys/class/net/$WIFI_IFACE/phy80211 ]] || die "$WIFI_IFACE is not a wireless interface"
  [[ -z $(ip -4 route show default dev "$WIFI_IFACE") && -z $(ip -6 route show default dev "$WIFI_IFACE") ]] \
    || die "$WIFI_IFACE carries the host's default route; refusing to turn it into an access point"
  [[ ! -e /sys/class/net/$WIFI_IFACE/master ]] || die "$WIFI_IFACE already belongs to a bridge or bond"
  [[ $(iw dev "$WIFI_IFACE" info | awk '$1 == "type" {print $2}') == managed ]] \
    || die "$WIFI_IFACE must be in managed mode before starting"
  WIFI_WAS_UP=0
  if ip -o link show dev "$WIFI_IFACE" | grep -Eq '<([^>]*,)?UP[,>]'; then WIFI_WAS_UP=1; fi
  PHY=$(<"/sys/class/net/$WIFI_IFACE/phy80211/name")
}

check_rfkill() {
  local block
  for block in /sys/class/ieee80211/"$PHY"/rfkill*; do
    if [[ $(<"$block/hard") == 1 ]]; then die "$WIFI_IFACE is hardware blocked by RF-kill; enable its physical radio switch"; fi
    if [[ $(<"$block/soft") == 1 ]]; then
      die "$WIFI_IFACE is software blocked by RF-kill; run 'sudo rfkill unblock ${block##*/rfkill}', then retry"
    fi
  done
}

# band5  the 5 GHz section of `iw phy` output (empty if the adapter has none)
band5() {
  iw phy "$PHY" info | awk '
    function emit() { if (is5) printf "%s", buf; buf = ""; is5 = 0 }
    /^\t[^\t]/ { emit(); inband = ($1 == "Band") }
    inband     { buf = buf $0 "\n" }
    $1 == "*" && $3 == "MHz" && $2 + 0 >= 5000 && $2 + 0 < 5900 { is5 = 1 }
    END        { emit() }'
}

check_adapter() {
  iw phy "$PHY" info | awk '/^[ \t]*\* AP$/ { f = 1 } END { exit !f }' \
    || die "$WIFI_IFACE does not support access-point mode"
  [[ -n $(band5) ]] || die "$WIFI_IFACE has no 5 GHz band"
}

############################################################################
# Settings, network and radio
############################################################################

validate_settings() {
  INTERNET=$(to_bool "$INTERNET")
  USE_WIFI6=$(to_bool "$USE_WIFI6")
  USB_ID=${USB_ID,,}
  PCI_ID=${PCI_ID,,}
  COUNTRY_CODE=${COUNTRY_CODE^^}
  if (( ${#SSID} < 1 || ${#SSID} > 32 )) || [[ $SSID == *[[:cntrl:]]* ]]; then die "SSID must be 1-32 bytes, no control characters"; fi
  [[ -z $PASSWORD || $PASSWORD =~ ^[[:print:]]{8,63}$ ]] || die "password must be 8-63 printable ASCII characters (or \"\" for an open network)"
  [[ $CHANNEL_WIDTH =~ ^(20|40|80)$ ]] || die "channel width must be 20, 40 or 80"
  [[ $CHANNEL =~ ^(auto|[0-9]+)$ ]] || die "channel must be a number or 'auto'"
  if [[ $CHANNEL != auto ]]; then
    (( ${#CHANNEL} <= 3 )) || die "invalid 5 GHz channel: $CHANNEL"
    CHANNEL=$(( 10#$CHANNEL ))
    (( CHANNEL >= 32 && CHANNEL <= 177 )) || die "invalid 5 GHz channel: $CHANNEL"
  fi
  [[ -z $COUNTRY_CODE || $COUNTRY_CODE =~ ^[A-Z]{2}$ ]] || die "country must be a two-letter code"
  [[ $USB_ID =~ ^[0-9a-f]{4}:[0-9a-f]{4}$ ]] || die "USB id must have the form VVVV:PPPP"
  [[ -z $PCI_ID || $PCI_ID =~ ^[0-9a-f]{4}:[0-9a-f]{4}$ ]] || die "PCI id must have the form VVVV:DDDD"
  [[ -z $WIFI_IFACE || $WIFI_IFACE =~ ^[a-zA-Z0-9_.:-]{1,15}$ ]] || die "invalid interface name"
  [[ $BRIDGE =~ ^[a-zA-Z0-9_.-]{1,15}$ && $BRIDGE != "$WIFI_IFACE" ]] || die "invalid bridge name"
  [[ $NFT_TABLE =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || die "invalid nftables table name"
  derive_network
}

# Computes PREFIX, NETMASK, DHCP_START and DHCP_END from CIDR and BRIDGE_IP.
derive_network() {
  local ip_re='^[0-9]+(\.[0-9]+){3}$' net bcast mask
  [[ $CIDR =~ ^[0-9.]+/[0-9]+$ && ${CIDR%/*} =~ $ip_re && $BRIDGE_IP =~ $ip_re ]] \
    || die "CIDR and BRIDGE_IP must look like 192.168.42.0/24 and 192.168.42.1"
  if ! ip2int "${CIDR%/*}" >/dev/null || ! ip2int "$BRIDGE_IP" >/dev/null; then die "invalid IPv4 address in CIDR or BRIDGE_IP"; fi
  PREFIX=${CIDR#*/}
  (( ${#PREFIX} <= 2 )) || die "invalid CIDR prefix length"
  PREFIX=$(( 10#$PREFIX ))
  (( PREFIX >= 8 && PREFIX <= 29 )) || die "CIDR prefix length must be between 8 and 29"
  mask=$(( (0xFFFFFFFF << (32 - PREFIX)) & 0xFFFFFFFF ))
  net=$(( $(ip2int "${CIDR%/*}") & mask ))
  bcast=$(( net | (~mask & 0xFFFFFFFF) ))
  (( $(ip2int "$BRIDGE_IP") == net + 1 )) || die "BRIDGE_IP must be $(int2ip $(( net + 1 ))), the first host address of $CIDR"
  CIDR="$(int2ip "$net")/$PREFIX"
  NETMASK=$(int2ip "$mask")
  DHCP_START=$(int2ip $(( net + 2 )))
  DHCP_END=$(int2ip $(( bcast - 1 )))
}

# Wi-Fi refuses to transmit on 5 GHz until a country is set, so find one.
set_regdomain() {
  REG_PREV=$(iw reg get | awk '/^country/ && !seen { sub(":", "", $2); print $2; seen = 1 }')
  : "${COUNTRY_CODE:=$REG_PREV}"
  [[ $COUNTRY_CODE =~ ^[A-Z]{2}$ ]] \
    || die "no regulatory country is set (found '${COUNTRY_CODE:-none}'); set COUNTRY_CODE in the script or pass --country=XX"
  if [[ $COUNTRY_CODE == "$REG_PREV" ]]; then REG_PREV=""; return 0; fi
  [[ $REG_PREV =~ ^([A-Z]{2}|00)$ ]] || die "cannot determine the current regulatory domain for rollback"
  save_state     # REG_PREV must be on disk before the domain changes
  quiet iw reg set "$COUNTRY_CODE"
}

# block_start CHANNEL WIDTH  first channel of the aligned WIDTH-MHz block holding CHANNEL
block_start() {
  local base=36 span=$(( $2 / 5 ))
  if (( $1 >= 149 )); then base=149; fi
  echo $(( $1 - ($1 - base) % span ))
}

# 5 GHz channels this adapter may use right now: not disabled, no-IR or DFS
usable_channels() {
  band5 | awk '$1 == "*" && $3 == "MHz" && !/disabled|no IR|radar/ { gsub(/[][]/, "", $4); print $4 }'
}

# Validate every 20 MHz member even for a manually selected primary channel.
# Radar channels are allowed manually; hostapd must complete CAC before success.
check_channel() {
  local band c start span=$(( CHANNEL_WIDTH / 5 )) line
  band=$(band5)
  start=$(block_start "$CHANNEL" "$CHANNEL_WIDTH")
  for (( c = start; c < start + span; c += 4 )); do
    line=$(awk -v ch="[$c]" '$1 == "*" && $3 == "MHz" && $4 == ch {print}' <<<"$band")
    [[ -n $line && $line != *disabled* ]] || die "channel $c in the requested $CHANNEL_WIDTH MHz block is unavailable"
    [[ $line != *"no IR"* || $line == *radar* ]] || die "channel $c does not permit initiating radiation in $COUNTRY_CODE"
  done
  (( (CHANNEL - start) % 4 == 0 )) || die "invalid primary channel $CHANNEL for the requested block"
}

# Check both more-specific and covering routes, including policy-routing tables.
check_network() {
  local routes route addr bits mask net wanted
  routes=$(ip -4 route show table all) || die "cannot inspect existing IPv4 routes"
  wanted=$(ip2int "$BRIDGE_IP")
  while read -r route; do
    [[ -n $route && $route != default ]] || continue
    # VPNs commonly express their default as two /1 routes.
    [[ $route != 0.0.0.0/1 && $route != 128.0.0.0/1 ]] || continue
    addr=${route%/*}; bits=${route#*/}
    if [[ $route != */* ]]; then bits=32; fi
    if [[ ! $bits =~ ^[0-9]+$ ]] || ! ip2int "$addr" >/dev/null; then continue; fi
    (( bits > 0 && bits <= 32 )) || continue
    mask=$(( (0xFFFFFFFF << (32 - (bits < PREFIX ? bits : PREFIX))) & 0xFFFFFFFF ))
    net=$(ip2int "$addr")
    (( (net & mask) != (wanted & mask) )) || die "$CIDR overlaps existing route $route; choose another CIDR"
  done < <(awk '{if ($1 ~ /^(local|broadcast|unreachable|blackhole|prohibit|throw)$/) print $2; else print $1}' <<<"$routes")
}

# First channel whose whole CHANNEL_WIDTH block is usable (lowest first)
pick_channel() {
  local usable c i span=$(( CHANNEL_WIDTH / 5 ))
  usable=" $(usable_channels | tr '\n' ' ') "
  for c in $usable; do
    (( $(block_start "$c" "$CHANNEL_WIDTH") == c )) || continue
    for (( i = 0; i < span; i += 4 )); do [[ $usable == *" $((c + i)) "* ]] || continue 2; done
    echo "$c"
    return 0
  done
  return 1
}

# Prints the hostapd radio lines, derived from what the adapter reports.
radio_conf() {
  local band ht vht start dir flags chwidth center
  band=$(band5)
  ht=$(awk '$1 == "Capabilities:" { print $2 }' <<<"$band")
  vht=$(awk -F'[()]' '/VHT Capabilities/ { print $2 }' <<<"$band")
  (( CHANNEL_WIDTH < 80 )) || [[ -n $vht ]] || die "$WIFI_IFACE has no 80 MHz (VHT) support; use --width=40"

  start=$(block_start "$CHANNEL" "$CHANNEL_WIDTH")
  dir=+; if (( (CHANNEL - start) / 4 % 2 )); then dir=-; fi
  flags=$(bit_flags "${ht:-0}" "${HT_BITS[@]}")$(stbc_flag $(( ${ht:-0} >> 8 & 3 )) RX-STBC)
  if (( CHANNEL_WIDTH >= 40 )); then flags+="[HT40$dir]"; fi
  chwidth=$(( CHANNEL_WIDTH == 80 ))
  center=$(( chwidth * (start + 6) ))

  echo "hw_mode=a"
  echo "channel=$CHANNEL"
  if grep -Eq "\[$CHANNEL\].*radar" <<<"$band"; then echo "ieee80211h=1"; fi   # DFS channel (manual --channel)
  echo "ieee80211n=1"
  echo "ht_capab=$flags"
  if [[ -n $vht ]]; then
    echo "ieee80211ac=1"
    echo "vht_capab=$(bit_flags "$vht" "${VHT_BITS[@]}")$(stbc_flag $(( vht >> 8 & 7 )) RX-STBC-)[MAX-A-MPDU-LEN-EXP$(( vht >> 23 & 7 ))]"
    echo "vht_oper_chwidth=$chwidth"
    echo "vht_oper_centr_freq_seg0_idx=$center"
  fi
  if (( USE_WIFI6 )) && grep -Eq 'HE Iftypes:.*AP' <<<"$band"; then
    echo "ieee80211ax=1"
    echo "he_oper_chwidth=$chwidth"
    echo "he_oper_centr_freq_seg0_idx=$center"
  fi
}

############################################################################
# Generated configuration
############################################################################

write_hostapd_conf() {
  local wpa="" ssid_hex     # hex encoding preserves leading/trailing spaces
  ssid_hex=$(printf '%s' "$SSID" | od -An -tx1 | tr -d ' \n')
  if [[ -n $PASSWORD ]]; then wpa=$(printf '%s\n' wpa=2 wpa_key_mgmt=WPA-PSK rsn_pairwise=CCMP "wpa_passphrase=$PASSWORD"); fi
  write_file "$STATE_DIR/hostapd.conf" <<EOF
interface=$WIFI_IFACE
bridge=$BRIDGE
driver=nl80211
ctrl_interface=$STATE_DIR/hostapd
ssid2=$ssid_hex
country_code=$COUNTRY_CODE
ieee80211d=1
wmm_enabled=1
dtim_period=1
disassoc_low_ack=0
auth_algs=1
$wpa
$RADIO_CONF
$HOSTAPD_EXTRA
EOF
}

write_dnsmasq_conf() {
  local no_internet=""
  # No internet: no DNS service and no gateway/DNS handed to clients.
  if (( ! INTERNET )); then no_internet=$'port=0\ndhcp-option=3\ndhcp-option=6'; fi
  write_file "$STATE_DIR/dnsmasq.conf" <<EOF
interface=$BRIDGE
except-interface=lo
bind-interfaces
dhcp-range=$DHCP_START,$DHCP_END,$NETMASK,$LEASE_TIME
dhcp-authoritative
dhcp-leasefile=$STATE_DIR/dnsmasq.leases
pid-file=
log-facility=-
log-dhcp
$no_internet
$DNSMASQ_EXTRA
EOF
}

# Priorities are numeric for old nft versions: 100 = srcnat, 0 = filter.
# Family inet so the isolation covers IPv6 too (needs kernel 5.2+ for NAT in inet).
nft_ruleset() {
  local nat="" v6=""
  if (( INTERNET )); then
    # NAT is IPv4-only, so IPv6 must never cross the bridge.
    v6="meta nfproto ipv6"
    nat="chain postrouting { type nat hook postrouting priority 100; ip saddr $CIDR oifname != \"$BRIDGE\" masquerade; };"
  fi
  # Only traffic crossing between the bridge and another interface is dropped;
  # host<->client and client<->client traffic is untouched.
  echo "table inet $NFT_TABLE { $nat chain forward { type filter hook forward priority 0;" \
       "$v6 iifname \"$BRIDGE\" oifname != \"$BRIDGE\" drop; $v6 oifname \"$BRIDGE\" iifname != \"$BRIDGE\" drop; }; }"
}

############################################################################
# Commands
############################################################################

usage() {
  cat <<EOF
Usage:
  $0 start <ssid> <password> [options]
  $0 stop
  $0 status

  ssid "" uses the default [$SSID]; password "" creates an OPEN (unencrypted) network.

Options for start (defaults come from the top of the script):
  --internet=true|false   share the host's internet connection   [$INTERNET]
  --iface=NAME            wireless interface to use              [${WIFI_IFACE:-auto}]
  --usb-id=VVVV:PPPP      USB id used to find the interface      [$USB_ID]
  --pci-id=VVVV:DDDD      PCI vendor:device id to find interface [${PCI_ID:-unset}]
  --channel=N|auto        5 GHz channel                          [$CHANNEL]
  --width=20|40|80        channel width in MHz                   [$CHANNEL_WIDTH]
  --country=XX            regulatory country code                [${COUNTRY_CODE:-system}]
EOF
}

parse_start_args() {
  local positional=()
  while (( $# )); do
    case $1 in   # turn "--opt value" into "--opt=value"
      --internet|--iface|--usb-id|--pci-id|--channel|--width|--country)
        (( $# > 1 )) || die "$1 needs a value"
        set -- "$1=$2" "${@:3}" ;;
    esac
    case $1 in
      --internet=*) INTERNET=${1#*=} ;;
      --iface=*)    WIFI_IFACE=${1#*=} ;;
      --usb-id=*)   USB_ID=${1#*=}; PCI_ID="" ;;
      --pci-id=*)   PCI_ID=${1#*=} ;;
      --channel=*)  CHANNEL=${1#*=} ;;
      --width=*)    CHANNEL_WIDTH=${1#*=} ;;
      --country=*)  COUNTRY_CODE=${1#*=} ;;
      --)           shift; positional+=("$@"); break ;;
      -*)           die "unknown option: $1 (see --help)" ;;
      *)            positional+=("$1") ;;
    esac
    shift
  done
  (( ${#positional[@]} == 2 )) || die "usage: start <ssid> <password> (\"\" = default ssid / open network; see --help)"
  SSID=${positional[0]:-$SSID}
  PASSWORD=${positional[1]}
}

# Undo start in small, checkpointed steps. Retain recovery state on failure.
clear_state() {
  printf -v "$1" '%s' ''
  save_state || { echo "hotspot: could not checkpoint cleanup" >&2; CLEANUP_FAILED=1; }
}

# Commit each restored setting immediately. A second stop must not overwrite a
# new setting made by someone else after a previous, partially successful stop.
restore() {
  local flag=$1; shift
  [[ -n ${!flag} ]] || return 0
  if "$@"; then clear_state "$flag"; else
    echo "hotspot: cleanup step failed: $*" >&2
    CLEANUP_FAILED=1
  fi
}

remove_nft() {
  local tables
  tables=$(nft list tables) || return 1
  if grep -qxF "table inet $NFT_TABLE" <<<"$tables"; then nft delete table inet "$NFT_TABLE"; fi
}

remove_bridge() {
  if [[ -e /sys/class/net/$BRIDGE ]]; then ip link delete "$BRIDGE"; fi
}

restore_wifi() {
  [[ -e /sys/class/net/$WIFI_IFACE ]] || return 0
  ip link set "$WIFI_IFACE" down || return 1
  iw dev "$WIFI_IFACE" set type managed || return 1
  if [[ $WIFI_WAS_UP == 1 ]]; then ip link set "$WIFI_IFACE" up || return 1; fi
}

restore_usb() {
  [[ -e $USB_DIR/power/control ]] || return 0  # unplugged
  printf '%s\n' "$USB_POWER_PREV" >"$USB_DIR/power/control"
}

restore_nm() {
  [[ -e /sys/class/net/$WIFI_IFACE ]] || return 0
  nm_managed "$NM_MANAGED_PREV" "$WIFI_IFACE"
}

set_forwarding() { printf '%s\n' "$1" >/proc/sys/net/ipv4/ip_forward; }

teardown() {
  CLEANUP_FAILED=0
  attempt stop_daemon "$STATE_DIR/dnsmasq.pid" dnsmasq
  attempt stop_daemon "$STATE_DIR/hostapd.pid" hostapd
  # Retain networking if a daemon could not be stopped, so retry remains safe.
  if (( ! CLEANUP_FAILED )); then
    restore NFT_OWNED remove_nft
    restore IP_FORWARD_PREV set_forwarding "$IP_FORWARD_PREV"
    restore FW_OWNED fw_zone remove
    restore BRIDGE_OWNED remove_bridge
    restore WIFI_OWNED restore_wifi
    restore USB_POWER_PREV restore_usb
    # Do not hand a half-restored adapter back to NetworkManager.
    if [[ -z $WIFI_OWNED ]]; then restore NM_MANAGED_PREV restore_nm; fi
    restore REG_PREV iw reg set "$REG_PREV"
  fi
  if (( CLEANUP_FAILED )); then
    save_state || true
    echo "hotspot: cleanup incomplete, state kept in $STATE_DIR (log: $LOG_FILE); fix the problem, then run '$0 stop' again" >&2
  else
    rm -rf -- "$STATE_DIR" || CLEANUP_FAILED=1
  fi
  return "$CLEANUP_FAILED"
}

rollback() {
  local rc=$?
  trap - EXIT ERR INT TERM
  (( rc != 0 )) || rc=1
  echo "hotspot: start failed (exit $rc${START_ERROR:+, $START_ERROR}), undoing changes." >&2
  if [[ -n $STARTING_PID ]] && jobs -pr | grep -qxF "$STARTING_PID"; then
    kill -KILL "$STARTING_PID" 2>/dev/null || true
    wait "$STARTING_PID" 2>/dev/null || true
  fi
  teardown || true
  echo "hotspot: End of $LOG_FILE:" >&2
  tail -n 30 "$LOG_FILE" >&2 2>/dev/null || true
  exit "$rc"
}

cmd_start() {
  parse_start_args "$@"
  validate_settings
  need hostapd hostapd_cli dnsmasq ip iw nft setsid timeout
  check_owned "$STATE_DIR"
  check_owned "$STATE_FILE"
  if daemon_pid "$STATE_DIR/hostapd.pid" hostapd >/dev/null || daemon_pid "$STATE_DIR/dnsmasq.pid" dnsmasq >/dev/null; then die "already running or degraded; run '$0 stop' first"; fi
  if [[ -e $STATE_DIR ]]; then ( load_state; teardown ); fi     # leftovers of a crashed run

  resolve_iface
  check_adapter
  check_rfkill
  ! ip link show "$BRIDGE" >/dev/null 2>&1 || die "network interface $BRIDGE already exists"
  check_network
  ! nft list table inet "$NFT_TABLE" >/dev/null 2>&1 || die "nftables table inet $NFT_TABLE already exists; choose another NFT_TABLE"

  # From here on, anything that fails is rolled back (including the regulatory domain).
  mkdir -m 700 "$STATE_DIR"
  save_state
  # Atomic replacement also removes an old dnsmasq-owned log or a stale symlink.
  write_file "$LOG_FILE" </dev/null
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'START_ERROR="line $LINENO"' ERR
  trap rollback EXIT
  set_regdomain
  if [[ $CHANNEL == auto ]]; then
    CHANNEL=$(retry 10 pick_channel) \
      || die "no usable non-DFS $CHANNEL_WIDTH MHz channel in regulatory domain $COUNTRY_CODE; try --width=40 or set a channel"
  fi
  check_channel
  RADIO_CONF=$(radio_conf)

  USB_DIR=$(usb_dir "$WIFI_IFACE")
  if [[ -n $USB_DIR && -r $USB_DIR/power/control ]]; then USB_POWER_PREV=$(<"$USB_DIR/power/control"); fi
  if (( INTERNET )); then IP_FORWARD_PREV=$(</proc/sys/net/ipv4/ip_forward); fi
  if command -v nmcli >/dev/null && [[ $(nmcli -g RUNNING general 2>/dev/null) == running ]]; then
    NM_MANAGED_PREV=$(nmcli -g GENERAL.NM-MANAGED device show "$WIFI_IFACE")
    [[ $NM_MANAGED_PREV == yes || $NM_MANAGED_PREV == no ]] || die "cannot determine NetworkManager ownership of $WIFI_IFACE"
  fi
  save_state
  write_hostapd_conf
  write_dnsmasq_conf
  quiet dnsmasq --test --conf-file="$STATE_DIR/dnsmasq.conf"

  log "Creating $BRIDGE ($BRIDGE_IP/$PREFIX)"
  if [[ -n $USB_POWER_PREV ]]; then echo on >"$USB_DIR/power/control"; fi
  BRIDGE_OWNED=1; save_state        # record intent before changing the host
  ip link add name "$BRIDGE" type bridge mcast_snooping 0
  WIFI_OWNED=1; save_state
  nm_managed no "${NM_MANAGED_PREV:+$WIFI_IFACE}" "$BRIDGE"   # NM_MANAGED_PREV is empty unless NM knows the adapter
  fw_zone change
  ip addr add "$BRIDGE_IP/$PREFIX" brd + dev "$BRIDGE"
  ip link set "$BRIDGE" up
  NFT_OWNED=1; save_state     # the pre-check above proved the name was free
  quiet nft -f - <<<"$(nft_ruleset)"

  log "Starting access point on $WIFI_IFACE (channel $CHANNEL, $CHANNEL_WIDTH MHz)"
  start_daemon "$STATE_DIR/hostapd.pid" hostapd -t "$STATE_DIR/hostapd.conf"
  local wait=$AP_WAIT
  if [[ $RADIO_CONF == *ieee80211h=1* ]]; then wait=$DFS_WAIT; log "DFS channel: waiting for the radar check (Ctrl-C aborts)"; fi
  wait_for_ap "$wait"

  log "Starting DHCP ($DHCP_START - $DHCP_END)"
  start_daemon "$STATE_DIR/dnsmasq.pid" dnsmasq --keep-in-foreground --conf-file="$STATE_DIR/dnsmasq.conf"
  if (( INTERNET )); then set_forwarding 1; fi
  wait_for_health

  log "Hotspot '$SSID' is up. Gateway $BRIDGE_IP, internet: $( (( INTERNET )) && echo shared || echo off )"
  trap - EXIT ERR INT TERM
}

cmd_stop() {
  load_state
  [[ -e $STATE_DIR ]] || { echo "hotspot: already stopped"; return 0; }
  echo "==> Stopping hotspot"
  teardown
}

# Match the listener's inode to this daemon's FDs. A different DHCP/DNS service
# on the host must never make a broken hotspot appear healthy.
owns_udp_port() {
  local pid=$1 port=$2 sockets
  sockets=$(readlink /proc/"$pid"/fd/* 2>/dev/null || true)
  awk -v sockets="$sockets" -v port="$port" '
    BEGIN {
      n = split(sockets, f, "\n")
      for (i = 1; i <= n; i++) if (f[i] ~ /^socket:\[/) {
        gsub(/^socket:\[|\]$/, "", f[i]); owned[f[i]] = 1
      }
    }
    $2 ~ (":" port "$") && owned[$10] { found = 1 }
    END { exit !found }' "/proc/$pid/net/udp" 2>/dev/null
}

# Shared by startup and status: output is empty only when all checks pass.
health() {
  local pid
  hostapd_enabled || echo "access point is not ENABLED (hostapd)"
  if pid=$(daemon_pid "$STATE_DIR/dnsmasq.pid" dnsmasq); then
    owns_udp_port "$pid" 0043 || echo "hotspot dnsmasq is not listening on DHCP (udp 67)"
    if (( INTERNET )); then owns_udp_port "$pid" 0035 || echo "hotspot dnsmasq is not listening on DNS (udp 53)"; fi
  else
    echo "dnsmasq is not running"
  fi
  ip -4 -o addr show dev "$BRIDGE" 2>/dev/null | grep -qF " $BRIDGE_IP/${PREFIX}" || echo "$BRIDGE no longer has $BRIDGE_IP/${PREFIX}"
  [[ $(readlink -f "/sys/class/net/$WIFI_IFACE/master" 2>/dev/null) == "/sys/devices/virtual/net/$BRIDGE" ]] || echo "$WIFI_IFACE is not attached to $BRIDGE"
  nft list table inet "$NFT_TABLE" >/dev/null 2>&1 || echo "hotspot firewall/NAT table is missing"
  if (( INTERNET )); then
    [[ $(</proc/sys/net/ipv4/ip_forward) == 1 ]] || echo "IPv4 forwarding is disabled"
  fi
  if [[ -n $FW_OWNED ]] && command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
    firewall-cmd --zone=trusted --query-interface="$BRIDGE" >/dev/null 2>&1 || echo "$BRIDGE is no longer in firewalld's trusted zone"
  fi
  return 0
}

wait_for_health() {
  local deadline=$(( SECONDS + SERVICE_WAIT )) problems="" stable=0
  while (( SECONDS < deadline )); do
    problems=$(health)
    if [[ -z $problems ]]; then
      stable=$((stable + 1))
      (( stable < 2 )) || return 0
    else
      stable=0
    fi
    # A dead child cannot recover; do not burn the entire timeout on it.
    if ! alive "$(<"$STATE_DIR/hostapd.pid")" || ! alive "$(<"$STATE_DIR/dnsmasq.pid")"; then break; fi
    sleep 0.5
  done
  die "hotspot failed its readiness checks: ${problems:-services did not remain ready}"
}

# Only current Wi-Fi stations count as connected; leases/neighbors merely add
# details, since both can outlive a client's connection. No network probing.
show_connected_devices() {
  local stations
  if ! stations=$(iw dev "$WIFI_IFACE" station dump 2>/dev/null); then
    echo "  connected devices: unavailable (could not read stations on $WIFI_IFACE)"
    return 0
  fi
  awk -v leases="$STATE_DIR/dnsmasq.leases" -v now="$(date +%s)" '
    BEGIN {
      while ((getline line < leases) > 0) {
        split(line, f, " ")
        if (f[1] !~ /^[0-9]+$/ || (f[1] != 0 && f[1] <= now)) continue
        key = tolower(f[2])
        ip[key] = f[3]
        if (f[4] != "*") host[key] = f[4]
      }
      close(leases)
    }
    # Bridge neighbors also identify clients using a static IPv4 address.
    FILENAME == ARGV[1] {
      if ($NF == "FAILED" || $NF == "INCOMPLETE") next
      for (i = 2; i < NF; i++) {
        if ($i == "lladdr") {
          key = tolower($(i + 1))
          if (!(key in ip)) ip[key] = $1
          break
        }
      }
      next
    }
    function emit() {
      if (mac == "") return
      rows = rows sprintf("    %-17s  %-15s  %-20s  %-10s  %-22s  %s\n",
                          mac, (ip[mac] ? ip[mac] : "-"),
                          (host[mac] ? host[mac] : "-"), sig, tx, rx)
      n++; mac = ""
    }
    /^Station /         { emit(); mac = tolower($2); sig = tx = rx = "-" }
    $1 == "signal:"     { sig = $2 " dBm" }
    /tx bitrate:/       { sub(/^[^:]*:[ \t]*/, ""); tx = $0 }
    /rx bitrate:/       { sub(/^[^:]*:[ \t]*/, ""); rx = $0 }
    END {
      emit()
      printf "  connected devices: %d\n", n
      if (!n) { print "    (none)"; exit }
      printf "    %-17s  %-15s  %-20s  %-10s  %-22s  %s\n",
             "MAC address", "IP address", "Name", "Signal", "TX rate", "RX rate"
      printf "%s", rows
      print "    - = unknown; names are supplied by clients via DHCP."
    }' <(ip -4 neigh show dev "$BRIDGE" 2>/dev/null || true) - <<<"$stations"
}

cmd_status() {
  local net=no problems rc=0
  load_state
  if ! daemon_pid "$STATE_DIR/hostapd.pid" hostapd >/dev/null && ! daemon_pid "$STATE_DIR/dnsmasq.pid" dnsmasq >/dev/null; then
    echo "hotspot: stopped"
    if [[ -e $STATE_DIR ]]; then echo "  leftovers of an earlier run are in $STATE_DIR (log: $LOG_FILE); run '$0 stop'"; fi
    return 3
  fi
  problems=$(health)
  if [[ -n $problems ]]; then
    echo "hotspot: DEGRADED"
    printf '  - %s\n' "${problems//$'\n'/$'\n  - '}"
    echo "  log: $LOG_FILE"
    rc=1
  else
    echo "hotspot: running"
  fi
  if (( INTERNET )); then net=shared; fi
  echo "  interface: $WIFI_IFACE   bridge: $BRIDGE ($BRIDGE_IP)   internet: $net"
  iw dev "$WIFI_IFACE" info 2>/dev/null | awk '$1 ~ /^(ssid|channel|txpower)$/ { sub(/^[ \t]+/, "  "); print }' || true
  show_connected_devices
  return "$rc"
}

main() {
  local cmd=${1:-help}
  shift || true
  case $cmd in stop|status) (( $# == 0 )) || die "$cmd does not take arguments";; esac
  case $cmd in
    start|stop|status)
      require_root "$cmd" "$@"
      # Status also takes the lock so it cannot read an in-progress transaction.
      need flock stat
      check_owned "$LOCK_FILE"
      exec 9>"$LOCK_FILE"
      flock -w 30 9 || die "another hotspot start/stop is still running" ;;
  esac
  case $cmd in
    start)          cmd_start "$@" ;;
    stop)           cmd_stop ;;
    status)         cmd_status ;;
    help|-h|--help) usage ;;
    *)              usage >&2; exit 2 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
