#!/usr/bin/env bash
# =============================================================================
# hotspot - low-latency 5 GHz Wi-Fi hotspot for VR game streaming
#
#   ./hotspot start <ssid> <password> [--internet=true|false] [--iface=NAME]
#                   [--usb-id=VVVV:PPPP] [--channel=N|auto] [--width=20|40|80]
#                   [--country=XX]
#   ./hotspot stop
#   ./hotspot status
#
# How it works (everything is runtime-only: `stop` or a reboot restores the host)
#   hostapd   runs the access point and attaches the adapter to the bridge
#   bridge    br-hotspot (iproute2) carries the host's gateway address
#   dnsmasq   DHCP on the bridge (+ DNS when the internet is shared)
#   nftables  one private table: NAT when sharing internet, isolation otherwise
#   firewalld if running, the bridge joins its "trusted" zone (runtime only)
#
# Host <-> headset game traffic is plain layer-2 traffic on the bridge; it never
# touches NAT. Radio settings (channel, width, HT/VHT/HE capabilities) are read
# from the adapter itself, so a different adapter needs no code changes.
#
# Requirements: bash 4+, hostapd (+ hostapd_cli), dnsmasq, ip (iproute2), iw, nft
# (nftables), flock (util-linux). NetworkManager and firewalld are optional.
#
# Firewall note: firewalld is handled automatically (the bridge is placed in the
# "trusted" zone until `stop`; a `firewall-cmd --reload` drops that binding, so
# restart the hotspot after one). With any other host firewall that drops traffic
# arriving on the bridge, allow the bridge interface (default: br-hotspot) in it:
# another firewall's "drop" cannot be overridden from a separate nftables table.
# =============================================================================
set -euo pipefail
shopt -s nullglob
export LC_ALL=C
PATH="$PATH:/usr/sbin:/sbin"

############################################################################
# CONFIGURATION - every tunable lives in this block
############################################################################

# --- Identity (./hotspot start <ssid> <password>) ---
SSID="VR-Hotspot"                    # used when the ssid argument is ""
# There is no default password: pass 8-63 characters (WPA2), or "" for an open network.

# --- Network ---
BRIDGE="br-hotspot"                  # bridge created for the hotspot
BRIDGE_IP="192.168.42.1"             # host address on the bridge (must be the first host address of CIDR)
CIDR="192.168.42.0/24"               # hotspot network; the DHCP pool is derived from it
LEASE_TIME="12h"
INTERNET=true                        # share the host's internet with clients (--internet=)

# --- Adapter ---
WIFI_IFACE=""                        # interface name; empty = find the adapter by USB_ID (--iface=)
USB_ID="13b1:0045"                   # Linksys WUSB6300 v2 (--usb-id=)

# --- Radio ---
COUNTRY_CODE=""                      # e.g. US; empty = keep the system's regulatory domain (--country=)
CHANNEL="auto"                       # auto = first fully usable non-DFS 5 GHz block (--channel=)
CHANNEL_WIDTH=80                     # 20, 40 or 80 MHz (--width=)
USE_WIFI6=true                       # use 802.11ax when the adapter supports it

# --- Escape hatches: raw lines appended to the generated configs ---
HOSTAPD_EXTRA=""
DNSMASQ_EXTRA=""

# --- Internals ---
STATE_DIR="/run/hotspot"             # runtime files; /run is cleared on reboot
NFT_TABLE="hotspot"                  # private nftables table (family inet)
LOCK_FILE="/run/hotspot.lock"        # serializes start/stop; outside STATE_DIR on purpose
LOG_FILE="/run/hotspot.log"          # progress + hostapd + dnsmasq log; outside STATE_DIR so a failed
                                     # start leaves it behind; truncated by each start

# IEEE 802.11 capability bit -> hostapd flag (bit positions are fixed by the standard).
HT_BITS=(0:LDPC 5:SHORT-GI-20 6:SHORT-GI-40 7:TX-STBC 11:MAX-AMSDU-7935)
VHT_BITS=(0:MAX-MPDU-7991 1:MAX-MPDU-11454 4:RXLDPC 5:SHORT-GI-80 7:TX-STBC-2BY1)

############################################################################
# Helpers
############################################################################

SELF=$(readlink -f "${BASH_SOURCE[0]}")
STATE_FILE="$STATE_DIR/state"

# Values that stop/status need later; start saves them to $STATE_FILE.
PHY="" USB_DIR="" USB_POWER_PREV="" IP_FORWARD_PREV="" NM_MANAGED_PREV="" REG_PREV="" BRIDGE_OWNED="" NFT_OWNED=""
SAVED_VARS=(WIFI_IFACE BRIDGE BRIDGE_IP INTERNET USB_DIR USB_POWER_PREV IP_FORWARD_PREV
            NM_MANAGED_PREV REG_PREV BRIDGE_OWNED NFT_OWNED)

die()  { echo "hotspot: $*" >&2; exit 1; }
log()  { echo "==> $*" | tee -a "$LOG_FILE"; }
need() { local c; for c; do command -v "$c" >/dev/null || die "required command not found: $c"; done; }

# retry N CMD...  run CMD until it succeeds, at most N times, 0.5 s apart
retry() { local n=$1; shift; until "$@"; do (( --n > 0 )) || return 1; sleep 0.5; done; }

# quiet CMD...  run CMD silently; show its output only if it fails
quiet() { local out; out=$("$@" 2>&1) || { echo "$out" >&2; return 1; }; }

to_bool() {
  case ${1,,} in
    1|true|yes|y|on)  echo 1 ;;
    0|false|no|n|off) echo 0 ;;
    *) die "not a boolean: '$1'" ;;
  esac
}

ip2int() { local a b c d; IFS=. read -r a b c d <<<"$1"; echo $(( a << 24 | b << 16 | c << 8 | d )); }
int2ip() { echo "$(( $1 >> 24 & 255 )).$(( $1 >> 16 & 255 )).$(( $1 >> 8 & 255 )).$(( $1 & 255 ))"; }

# bit_flags VALUE BIT:FLAG...  ->  "[FLAG][FLAG]" for every bit set in VALUE
bit_flags() {
  local value=$1 spec; shift
  for spec; do
    if (( value >> ${spec%%:*} & 1 )); then printf '[%s]' "${spec#*:}"; fi
  done
}

# stbc_flag N PREFIX  RX-STBC is a multi-bit field holding the max stream count N -> "[PREFIX12..N]"
stbc_flag() { local s=("" 1 12 123 1234); if (( $1 >= 1 && $1 <= 4 )); then printf '[%s%s]' "$2" "${s[$1]}"; fi; }

# write_file PATH  replace PATH with stdin atomically (temp file + rename), so a crash leaves either
# the old or the new content, never half a file. mktemp makes the file 0600.
write_file() {
  local tmp
  tmp=$(mktemp "$1.XXXXXX") || return 1
  cat >"$tmp" && mv -f "$tmp" "$1" || { rm -f "$tmp"; return 1; }
}

save_state() { local v; for v in "${SAVED_VARS[@]}"; do printf '%s=%q\n' "$v" "${!v}"; done | write_file "$STATE_FILE"; }
load_state() { if [[ -r $STATE_FILE ]]; then source "$STATE_FILE"; fi; }

# alive PID  true if PID is running; a zombie (exited, not yet reaped by its parent) is not
alive() {
  local state
  state=$(awk '/^State:/ { print $2 }' "/proc/$1/status" 2>/dev/null) || return 1
  [[ -n $state && $state != [ZXx] ]]
}

# daemon_pid PIDFILE NAME  prints the pid if PIDFILE names a live process called NAME
daemon_pid() {
  local pid
  [[ -r $1 ]] || return 1
  pid=$(<"$1")
  [[ $(cat "/proc/$pid/comm" 2>/dev/null) == "$2" ]] && alive "$pid" || return 1
  echo "$pid"
}

stop_daemon() {
  local pid sig i
  pid=$(daemon_pid "$1" "$2") || return 0
  for sig in TERM KILL; do
    kill -s "$sig" "$pid" 2>/dev/null || true
    for i in {1..20}; do alive "$pid" || return 0; sleep 0.25; done
  done
  echo "hotspot: $2 (pid $pid) would not exit" >&2
  return 1
}

# attempt CMD...  run one cleanup step; if it fails, say so and carry on with the rest
attempt() { "$@" || { echo "hotspot: cleanup step failed: $*" >&2; CLEANUP_FAILED=1; }; }

# hostapd_enabled  true once hostapd reports the AP as ENABLED (not merely started)
hostapd_enabled() {
  [[ $(hostapd_cli -p "$STATE_DIR/hostapd" -i "$WIFI_IFACE" status 2>/dev/null) == *state=ENABLED* ]]
}

# nm_set DEV yes|no  set NetworkManager's managed flag and confirm NM acted on it
# (an unmanaged device is state "10 (unmanaged)"); hostapd must not start while NM still owns the adapter
nm_set() {
  nmcli device set "$1" managed "$2" >/dev/null 2>&1 || return 1
  [[ $(nmcli -g GENERAL.NM-MANAGED device show "$1" 2>/dev/null) == "$2" ]] || return 1
  [[ $2 == yes || $(nmcli -g GENERAL.STATE device show "$1" 2>/dev/null) == "10 "* ]]
}

# nm_managed yes|no IFACE...  hand IFACE to / take it from NetworkManager; no-op if NM is not running
nm_managed() {
  local state=$1 dev; shift
  command -v nmcli >/dev/null && [[ $(nmcli -g RUNNING general 2>/dev/null) == running ]] || return 0
  for dev; do
    if [[ -z $dev ]]; then continue; fi
    retry 10 nm_set "$dev" "$state" || { echo "hotspot: NetworkManager did not accept managed=$state for $dev" >&2; return 1; }
  done
}

# fw_zone change|remove  bind the bridge to firewalld's trusted zone (runtime only; no-op unless firewalld is running)
fw_zone() {
  command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1 || return 0
  # a `firewall-cmd --reload` already dropped the binding: nothing left to remove
  if [[ $1 == remove ]] && ! firewall-cmd --zone=trusted --query-interface="$BRIDGE" >/dev/null 2>&1; then return 0; fi
  quiet firewall-cmd --zone=trusted "--$1-interface=$BRIDGE"
}

require_root() {
  (( EUID == 0 )) && return 0
  command -v sudo >/dev/null || die "must be run as root (sudo not found)"
  exec sudo -- "$SELF" "$@"
}

############################################################################
# Adapter detection (sysfs + iw)
############################################################################

# usb_dir IFACE  sysfs directory of the USB device behind IFACE (empty if not USB)
usb_dir() {
  local dir
  dir=$(readlink -f "/sys/class/net/$1/device") || return 0
  while [[ $dir == /sys/?* ]]; do
    if [[ -r $dir/idVendor ]]; then echo "$dir"; return 0; fi
    dir=${dir%/*}
  done
}

usb_id() {
  local dir
  dir=$(usb_dir "$1")
  if [[ -n $dir ]]; then echo "$(<"$dir/idVendor"):$(<"$dir/idProduct")"; fi
}

# wifi_ifaces  one "NAME USB_ID" line per wireless interface (USB_ID empty if not USB)
wifi_ifaces() {
  local p name
  for p in /sys/class/net/*/phy80211; do
    name=${p%/phy80211}; name=${name##*/}
    echo "$name $(usb_id "$name")"
  done
}

resolve_iface() {
  if [[ -z $WIFI_IFACE ]]; then
    WIFI_IFACE=$(wifi_ifaces | awk -v id="$USB_ID" '$2 == id && !found { print $1; found = 1 }')
    [[ -n $WIFI_IFACE ]] || die "no wireless interface with USB id $USB_ID found (is its driver loaded?)
Wireless interfaces present (name, USB id):
$(wifi_ifaces | sed 's/^/  /')
Pick one with --iface=NAME or --usb-id=VVVV:PPPP"
  fi
  [[ -e /sys/class/net/$WIFI_IFACE/phy80211 ]] || die "$WIFI_IFACE is not a wireless interface"
  [[ -z $(ip -4 route show default dev "$WIFI_IFACE") ]] \
    || die "$WIFI_IFACE carries the host's default route; refusing to turn it into an access point"
  PHY=$(<"/sys/class/net/$WIFI_IFACE/phy80211/name")
}

# band5  the 5 GHz section of `iw phy` output (empty if the adapter has none)
band5() {
  iw phy "$PHY" info | awk '
    function emit() { if (is5) printf "%s", buf; buf = ""; is5 = 0 }
    /^\t[^\t]/ { emit(); inband = ($1 == "Band") }
    inband     { buf = buf $0 "\n" }
    $1 == "*" && $3 == "MHz" && $2 + 0 >= 5000 && $2 + 0 < 5900 { is5 = 1 }
    END        { emit() }'
}

check_adapter() {
  iw phy "$PHY" info | awk '/^[ \t]*\* AP$/ { f = 1 } END { exit !f }' \
    || die "$WIFI_IFACE does not support access-point mode"
  [[ -n $(band5) ]] || die "$WIFI_IFACE has no 5 GHz band"
}

############################################################################
# Settings, network and radio
############################################################################

validate_settings() {
  INTERNET=$(to_bool "$INTERNET")
  USE_WIFI6=$(to_bool "$USE_WIFI6")
  USB_ID=${USB_ID,,}
  COUNTRY_CODE=${COUNTRY_CODE^^}
  (( ${#SSID} >= 1 && ${#SSID} <= 32 )) && [[ $SSID != *[[:cntrl:]]* ]] || die "SSID must be 1-32 bytes, no control characters"
  [[ -z $PASSWORD || $PASSWORD =~ ^[[:print:]]{8,63}$ ]] || die "password must be 8-63 printable ASCII characters (or \"\" for an open network)"
  [[ $CHANNEL_WIDTH =~ ^(20|40|80)$ ]] || die "channel width must be 20, 40 or 80"
  [[ $CHANNEL =~ ^(auto|[0-9]+)$ ]] || die "channel must be a number or 'auto'"
  derive_network
}

# Computes PREFIX, NETMASK, DHCP_START and DHCP_END from CIDR and BRIDGE_IP.
derive_network() {
  local ip_re='^[0-9]+(\.[0-9]+){3}$' net bcast mask
  [[ $CIDR =~ ^[0-9.]+/[0-9]+$ && ${CIDR%/*} =~ $ip_re && $BRIDGE_IP =~ $ip_re ]] \
    || die "CIDR and BRIDGE_IP must look like 192.168.42.0/24 and 192.168.42.1"
  PREFIX=${CIDR#*/}
  (( PREFIX >= 8 && PREFIX <= 29 )) || die "CIDR prefix length must be between 8 and 29"
  mask=$(( (0xFFFFFFFF << (32 - PREFIX)) & 0xFFFFFFFF ))
  net=$(( $(ip2int "${CIDR%/*}") & mask ))
  bcast=$(( net | (~mask & 0xFFFFFFFF) ))
  (( $(ip2int "$BRIDGE_IP") == net + 1 )) || die "BRIDGE_IP must be $(int2ip $(( net + 1 ))), the first host address of $CIDR"
  CIDR="$(int2ip "$net")/$PREFIX"
  NETMASK=$(int2ip "$mask")
  DHCP_START=$(int2ip $(( net + 2 )))
  DHCP_END=$(int2ip $(( bcast - 1 )))
}

# Wi-Fi refuses to transmit on 5 GHz until a country is set, so find one.
set_regdomain() {
  REG_PREV=$(iw reg get | awk '/^country/ && !seen { sub(":", "", $2); print $2; seen = 1 }')
  : "${COUNTRY_CODE:=$REG_PREV}"
  [[ $COUNTRY_CODE =~ ^[A-Z]{2}$ ]] \
    || die "no regulatory country is set (found '${COUNTRY_CODE:-none}'); set COUNTRY_CODE in the script or pass --country=XX"
  save_state     # REG_PREV must be on disk before the domain changes
  quiet iw reg set "$COUNTRY_CODE"
}

# block_start CHANNEL WIDTH  first channel of the aligned WIDTH-MHz block holding CHANNEL
block_start() {
  local base=36 span=$(( $2 / 20 * 4 ))
  if (( $1 >= 149 )); then base=149; fi
  echo $(( $1 - ($1 - base) % span ))
}

# 5 GHz channels this adapter may use right now: not disabled, no-IR or DFS
usable_channels() {
  band5 | awk '$1 == "*" && $3 == "MHz" && !/disabled|no IR|radar/ { gsub(/[][]/, "", $4); print $4 }'
}

# First channel whose whole CHANNEL_WIDTH block is usable (lowest first)
pick_channel() {
  local usable c i span=$(( CHANNEL_WIDTH / 20 * 4 ))
  usable=" $(usable_channels | tr '\n' ' ') "
  for c in $usable; do
    (( $(block_start "$c" "$CHANNEL_WIDTH") == c )) || continue
    for (( i = 0; i < span; i += 4 )); do [[ $usable == *" $((c + i)) "* ]] || continue 2; done
    echo "$c"
    return 0
  done
  return 1
}

# Prints the hostapd radio lines, derived from what the adapter reports.
radio_conf() {
  local band ht vht start dir flags chwidth center
  band=$(band5)
  ht=$(awk '$1 == "Capabilities:" { print $2 }' <<<"$band")
  vht=$(awk -F'[()]' '/VHT Capabilities/ { print $2 }' <<<"$band")
  (( CHANNEL_WIDTH < 80 )) || [[ -n $vht ]] || die "$WIFI_IFACE has no 80 MHz (VHT) support; use --width=40"

  start=$(block_start "$CHANNEL" "$CHANNEL_WIDTH")
  dir=+; if (( (CHANNEL - start) / 4 % 2 )); then dir=-; fi
  flags=$(bit_flags "${ht:-0}" "${HT_BITS[@]}")$(stbc_flag $(( ${ht:-0} >> 8 & 3 )) RX-STBC)
  if (( CHANNEL_WIDTH >= 40 )); then flags+="[HT40$dir]"; fi
  chwidth=$(( CHANNEL_WIDTH == 80 ))
  center=$(( chwidth * (start + 6) ))

  echo "hw_mode=a"
  echo "channel=$CHANNEL"
  if grep -Eq "\[$CHANNEL\].*radar" <<<"$band"; then echo "ieee80211h=1"; fi   # DFS channel (manual --channel)
  echo "ieee80211n=1"
  echo "ht_capab=$flags"
  if [[ -n $vht ]]; then
    echo "ieee80211ac=1"
    echo "vht_capab=$(bit_flags "$vht" "${VHT_BITS[@]}")$(stbc_flag $(( vht >> 8 & 7 )) RX-STBC-)[MAX-A-MPDU-LEN-EXP$(( vht >> 23 & 7 ))]"
    echo "vht_oper_chwidth=$chwidth"
    echo "vht_oper_centr_freq_seg0_idx=$center"
  fi
  if (( USE_WIFI6 )) && grep -Eq 'HE Iftypes:.*AP' <<<"$band"; then
    echo "ieee80211ax=1"
    echo "he_oper_chwidth=$chwidth"
    echo "he_oper_centr_freq_seg0_idx=$center"
  fi
}

############################################################################
# Generated configuration
############################################################################

write_hostapd_conf() {
  local wpa=""     # empty password = open network: no WPA lines at all
  if [[ -n $PASSWORD ]]; then wpa=$(printf '%s\n' wpa=2 wpa_key_mgmt=WPA-PSK rsn_pairwise=CCMP "wpa_passphrase=$PASSWORD"); fi
  write_file "$STATE_DIR/hostapd.conf" <<EOF
interface=$WIFI_IFACE
bridge=$BRIDGE
driver=nl80211
ctrl_interface=$STATE_DIR/hostapd
ssid=$SSID
country_code=$COUNTRY_CODE
ieee80211d=1
wmm_enabled=1
dtim_period=1
disassoc_low_ack=0
auth_algs=1
$wpa
$RADIO_CONF
$HOSTAPD_EXTRA
EOF
}

write_dnsmasq_conf() {
  local no_internet=""
  # No internet: no DNS service and no gateway/DNS handed to clients.
  if (( ! INTERNET )); then no_internet=$'port=0\ndhcp-option=3\ndhcp-option=6'; fi
  write_file "$STATE_DIR/dnsmasq.conf" <<EOF
interface=$BRIDGE
except-interface=lo
bind-interfaces
dhcp-range=$DHCP_START,$DHCP_END,$NETMASK,$LEASE_TIME
dhcp-authoritative
dhcp-leasefile=$STATE_DIR/dnsmasq.leases
pid-file=$STATE_DIR/dnsmasq.pid
log-facility=$LOG_FILE
log-dhcp
$no_internet
$DNSMASQ_EXTRA
EOF
}

# Priorities are numeric for old nft versions: 100 = srcnat, 0 = filter.
# Family inet so the isolation covers IPv6 too (needs kernel 5.2+ for NAT in inet).
nft_ruleset() {
  local nat="" v6=""
  if (( INTERNET )); then
    # NAT is IPv4-only, so IPv6 must never cross the bridge.
    v6="meta nfproto ipv6"
    nat="chain postrouting { type nat hook postrouting priority 100; ip saddr $CIDR oifname != \"$BRIDGE\" masquerade; };"
  fi
  # Only traffic crossing between the bridge and another interface is dropped;
  # host<->client and client<->client traffic is untouched.
  echo "table inet $NFT_TABLE { $nat chain forward { type filter hook forward priority 0;" \
       "$v6 iifname \"$BRIDGE\" oifname != \"$BRIDGE\" drop; $v6 oifname \"$BRIDGE\" iifname != \"$BRIDGE\" drop; }; }"
}

############################################################################
# Commands
############################################################################

usage() {
  cat <<EOF
Usage:
  $0 start <ssid> <password> [options]
  $0 stop
  $0 status

  ssid "" uses the default [$SSID]; password "" creates an OPEN (unencrypted) network.

Options for start (defaults come from the top of the script):
  --internet=true|false   share the host's internet connection   [$INTERNET]
  --iface=NAME            wireless interface to use              [${WIFI_IFACE:-auto}]
  --usb-id=VVVV:PPPP      USB id used to find the interface      [$USB_ID]
  --channel=N|auto        5 GHz channel                          [$CHANNEL]
  --width=20|40|80        channel width in MHz                   [$CHANNEL_WIDTH]
  --country=XX            regulatory country code                [${COUNTRY_CODE:-system}]
EOF
}

parse_start_args() {
  local positional=()
  while (( $# )); do
    case $1 in   # turn "--opt value" into "--opt=value"
      --internet|--iface|--usb-id|--channel|--width|--country)
        (( $# > 1 )) || die "$1 needs a value"
        set -- "$1=$2" "${@:3}" ;;
    esac
    case $1 in
      --internet=*) INTERNET=${1#*=} ;;
      --iface=*)    WIFI_IFACE=${1#*=} ;;
      --usb-id=*)   USB_ID=${1#*=} ;;
      --channel=*)  CHANNEL=${1#*=} ;;
      --width=*)    CHANNEL_WIDTH=${1#*=} ;;
      --country=*)  COUNTRY_CODE=${1#*=} ;;
      -*)           die "unknown option: $1 (see --help)" ;;
      *)            positional+=("$1") ;;
    esac
    shift
  done
  (( ${#positional[@]} == 2 )) || die "usage: start <ssid> <password> (\"\" = default ssid / open network; see --help)"
  SSID=${positional[0]:-$SSID}
  PASSWORD=${positional[1]}
}

# Undo everything start does. Safe to run at any time, in any state, and to repeat. Best effort:
# a failing step is reported and makes teardown return 1 (keeping $STATE_DIR so `stop` can retry),
# but never skips the later steps.
teardown() {
  CLEANUP_FAILED=0
  attempt stop_daemon "$STATE_DIR/dnsmasq.pid" dnsmasq
  attempt stop_daemon "$STATE_DIR/hostapd.pid" hostapd
  if [[ -n $NFT_OWNED ]] && nft list table inet "$NFT_TABLE" >/dev/null 2>&1; then attempt nft delete table inet "$NFT_TABLE"; fi
  if [[ -n $IP_FORWARD_PREV ]]; then attempt tee /proc/sys/net/ipv4/ip_forward <<<"$IP_FORWARD_PREV" >/dev/null; fi
  # Only touch a bridge this run created (the name alone proves nothing); from then on the adapter was ours too.
  if [[ -n $BRIDGE_OWNED ]]; then
    attempt fw_zone remove
    if ip link show "$BRIDGE" >/dev/null 2>&1; then attempt ip link delete "$BRIDGE"; fi
    if [[ -e /sys/class/net/$WIFI_IFACE ]]; then          # skipped if the adapter was unplugged
      attempt ip link set "$WIFI_IFACE" down              # the mode can only change while the link is down
      attempt iw dev "$WIFI_IFACE" set type managed       # hostapd leaves the radio in AP mode
    fi
  fi
  if [[ -n $USB_DIR && -n $USB_POWER_PREV && -e $USB_DIR/power/control ]]; then attempt tee "$USB_DIR/power/control" <<<"$USB_POWER_PREV" >/dev/null; fi
  if [[ -n $NM_MANAGED_PREV && -e /sys/class/net/$WIFI_IFACE ]]; then attempt nm_managed "$NM_MANAGED_PREV" "$WIFI_IFACE"; fi
  if [[ -n $REG_PREV ]]; then attempt iw reg set "$REG_PREV"; fi
  if (( CLEANUP_FAILED )); then
    save_state     # what is left to undo must survive; every step above is safe to repeat
    echo "hotspot: cleanup incomplete, state kept in $STATE_DIR (log: $LOG_FILE); fix the problem, then run '$0 stop' again" >&2
  else
    rm -rf "$STATE_DIR"
  fi
  return "$CLEANUP_FAILED"
}

rollback() {
  trap - EXIT
  echo "hotspot: start failed, undoing changes. End of $LOG_FILE:" >&2
  tail -n 10 "$LOG_FILE" >&2 2>/dev/null || true     # hostapd -f sends its startup errors there
  teardown
}

cmd_start() {
  parse_start_args "$@"
  validate_settings
  need hostapd hostapd_cli dnsmasq ip iw nft
  if daemon_pid "$STATE_DIR/hostapd.pid" hostapd >/dev/null; then die "already running; run '$0 stop' first"; fi
  if [[ -e $STATE_DIR ]]; then ( load_state; teardown ); fi     # leftovers of a crashed run

  resolve_iface
  check_adapter
  ! ip link show "$BRIDGE" >/dev/null 2>&1 || die "network interface $BRIDGE already exists"
  [[ -z $(ip -4 route show to root "$CIDR") ]] || die "$CIDR is already routed on this host; choose another CIDR"
  ! nft list table inet "$NFT_TABLE" >/dev/null 2>&1 || die "nftables table inet $NFT_TABLE already exists; choose another NFT_TABLE"

  # From here on, anything that fails is rolled back (including the regulatory domain).
  trap 'exit 1' INT TERM
  trap rollback EXIT
  mkdir -p "$STATE_DIR"
  : >"$LOG_FILE"
  set_regdomain
  if [[ $CHANNEL == auto ]]; then
    CHANNEL=$(retry 10 pick_channel) \
      || die "no usable non-DFS $CHANNEL_WIDTH MHz channel in regulatory domain $COUNTRY_CODE; try --width=40 or set a channel"
  fi
  RADIO_CONF=$(radio_conf)

  USB_DIR=$(usb_dir "$WIFI_IFACE")
  if [[ -n $USB_DIR ]]; then USB_POWER_PREV=$(<"$USB_DIR/power/control"); fi
  if (( INTERNET )); then IP_FORWARD_PREV=$(</proc/sys/net/ipv4/ip_forward); fi
  NM_MANAGED_PREV=$(nmcli -g GENERAL.NM-MANAGED device show "$WIFI_IFACE" 2>/dev/null || true)
  save_state
  write_hostapd_conf
  write_dnsmasq_conf

  log "Creating $BRIDGE ($BRIDGE_IP/$PREFIX)"
  if [[ -n $USB_DIR ]]; then echo on >"$USB_DIR/power/control"; fi   # no USB autosuspend latency
  ip link add name "$BRIDGE" type bridge mcast_snooping 0
  BRIDGE_OWNED=1; save_state
  nm_managed no "${NM_MANAGED_PREV:+$WIFI_IFACE}" "$BRIDGE"   # NM_MANAGED_PREV is empty unless NM knows the adapter
  fw_zone change
  ip addr add "$BRIDGE_IP/$PREFIX" brd + dev "$BRIDGE"
  ip link set "$BRIDGE" up
  NFT_OWNED=1; save_state     # the pre-check above proved the name was free
  quiet nft -f - <<<"$(nft_ruleset)"

  log "Starting access point on $WIFI_IFACE (channel $CHANNEL, $CHANNEL_WIDTH MHz)"
  quiet hostapd -B -t -f "$LOG_FILE" -P "$STATE_DIR/hostapd.pid" "$STATE_DIR/hostapd.conf" 9>&-
  local tries=20     # a DFS channel is radar-checked (CAC) before it goes on air: ~1 min, 10 min on weather-radar channels
  if [[ $RADIO_CONF == *ieee80211h=1* ]]; then tries=1300; log "DFS channel: waiting for the radar check (Ctrl-C aborts)"; fi
  retry "$tries" hostapd_enabled || die "hostapd started but the AP never reached the ENABLED state"

  log "Starting DHCP ($DHCP_START - $DHCP_END)"
  quiet dnsmasq --conf-file="$STATE_DIR/dnsmasq.conf" 9>&-
  if (( INTERNET )); then echo 1 >/proc/sys/net/ipv4/ip_forward; fi

  trap - EXIT
  log "Hotspot '$SSID' is up. Gateway $BRIDGE_IP, internet: $( (( INTERNET )) && echo shared || echo off )"
}

cmd_stop() {
  load_state
  log "Stopping hotspot"
  teardown
}

# health  one line per failed check (AP enabled, DHCP serving, gateway address present); silent when healthy
health() {
  hostapd_enabled || echo "access point is not ENABLED (hostapd)"
  if daemon_pid "$STATE_DIR/dnsmasq.pid" dnsmasq >/dev/null; then
    awk '$2 ~ /:0043$/ { f = 1 } END { exit !f }' /proc/net/udp || echo "dnsmasq is running but nothing listens on the DHCP port (udp 67)"
  else
    echo "dnsmasq is not running"
  fi
  ip -4 -o addr show dev "$BRIDGE" 2>/dev/null | grep -qF " $BRIDGE_IP/" || echo "$BRIDGE no longer has $BRIDGE_IP"
}

cmd_status() {
  local net=no problems
  load_state
  if ! daemon_pid "$STATE_DIR/hostapd.pid" hostapd >/dev/null && ! daemon_pid "$STATE_DIR/dnsmasq.pid" dnsmasq >/dev/null; then
    echo "hotspot: stopped"
    if [[ -e $STATE_DIR ]]; then echo "  leftovers of an earlier run are in $STATE_DIR (log: $LOG_FILE); run '$0 stop'"; fi
    return 3
  fi
  problems=$(health)
  if [[ -n $problems ]]; then
    echo "hotspot: DEGRADED"
    sed 's/^/  - /' <<<"$problems"
    echo "  log: $LOG_FILE"
    return 1
  fi
  if (( INTERNET )); then net=shared; fi
  echo "hotspot: running"
  echo "  interface: $WIFI_IFACE   bridge: $BRIDGE ($BRIDGE_IP)   internet: $net"
  iw dev "$WIFI_IFACE" info | awk '$1 ~ /^(ssid|channel|txpower)$/ { sub(/^[ \t]+/, "  "); print }'
  echo "  stations:"
  iw dev "$WIFI_IFACE" station dump | awk -v leases="$STATE_DIR/dnsmasq.leases" '
    BEGIN { while ((getline line < leases) > 0) { split(line, f, " "); ip[f[2]] = f[3]; host[f[2]] = f[4] } }
    function emit() {
      if (mac == "") return
      printf "    %s  %-15s %-14s signal %s dBm  tx %s\n", mac, ip[mac], host[mac], sig, tx
      n++; mac = ""
    }
    /^Station/            { emit(); mac = $2; sig = tx = "?" }
    $1 == "signal:"       { sig = $2 }
    /tx bitrate:/         { sub(/^[^:]*:[ \t]*/, ""); tx = $0 }
    END                   { emit(); if (!n) print "    (none)" }'
}

main() {
  local cmd=${1:-help}
  shift || true
  case $cmd in
    start|stop)
      require_root "$cmd" "$@"
      # One start/stop at a time. The daemons are launched with 9>&- so they never inherit the lock.
      need flock
      exec 9>"$LOCK_FILE"
      flock -w 30 9 || die "another hotspot start/stop is still running" ;;
  esac
  case $cmd in
    start)          cmd_start "$@" ;;
    stop)           cmd_stop ;;
    status)         cmd_status ;;
    help|-h|--help) usage ;;
    *)              usage >&2; exit 2 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
