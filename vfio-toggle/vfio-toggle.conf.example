#############################################################################
# vfio-toggle configuration
#
# Copy this file to /etc/vfio-toggle/vfio-toggle.conf and edit it:
#
#   sudo mkdir -p /etc/vfio-toggle
#   sudo cp vfio-toggle.conf.example /etc/vfio-toggle/vfio-toggle.conf
#   sudo chmod 600 /etc/vfio-toggle/vfio-toggle.conf
#   sudo vfio-toggle.sh list-devices        # find your GPU's PCI address
#   sudo nano /etc/vfio-toggle/vfio-toggle.conf
#
# This file is sourced as root, so vfio-toggle.sh will refuse to load it
# unless it is root-owned and not group/other-writable (chmod 600 above).
#
# Any line you delete just falls back to the script's built-in default, so
# you don't need to keep options you're not changing.
#############################################################################

# PCI Bus/Device/Function address(es) of the GPU you want to toggle, in
# domain:bus:device.function form (as shown by `lspci -D` or by
# `vfio-toggle.sh list-devices`). You normally only need to list the GPU's
# own VGA/3D-controller function (the one usually ending in ".0") -- the
# script automatically discovers and includes every other function in the
# same IOMMU group (HDMI/DP audio, USB-C controller, etc.), because all of
# them have to move to vfio-pci together.
#
# If you have two identical GPUs and only want to pass one through, list
# only that card's address here; the other card, and anything else on the
# system still using the same driver, is left completely untouched.
GPU_PCI_IDS=(
  "0000:01:00.0"
)

# Restart the display manager after 'bind' completes (GPU now on vfio-pci).
# This is OPTIONAL and only useful if the host has a secondary GPU to fall
# back to. The display manager is always stopped before handing the GPU to
# vfio-pci (on 'bind') if it was running, regardless of this setting.
# Restarting the display manager after 'unbind' (restoring host graphics)
# is NOT optional and always happens.
RESTART_DISPLAY_MANAGER_AFTER_BIND=true

# Fully unload (modprobe -r) the GPU driver's kernel module stack when
# binding to vfio-pci, instead of only unbinding the device in sysfs. This
# matches what most single-GPU-passthrough guides recommend and gives some
# drivers (notably Nvidia's proprietary driver) a cleaner slate to return
# to afterward. The script only does this when no OTHER PCI device on the
# system is still using that driver, so it remains safe with two identical
# GPUs where only one is listed above. Set to false to always use
# per-device sysfs unbind only and never touch already-loaded modules.
ALLOW_FULL_MODULE_UNLOAD=true

# Try to unbind the EFI/VESA/simple boot framebuffer before unbinding the
# GPU driver. This mainly matters for single-GPU passthrough, where the
# firmware framebuffer can otherwise prevent the GPU driver from cleanly
# releasing the device. It's a harmless no-op if there's nothing to
# release (e.g. you have a separate GPU driving the console).
RELEASE_BOOT_FRAMEBUFFER=true

# Unbind the legacy VT/framebuffer-console layer (fbcon) so it releases
# its reference to the GPU's framebuffer console. Like the boot
# framebuffer, this can prevent a clean driver unbind, mainly in
# single-GPU passthrough setups. Unlike the boot framebuffer, fbcon IS
# automatically rebound when the host driver is restored, giving you a
# working Ctrl+Alt+F<n> text console again.
RELEASE_VT_CONSOLE=true

# Perform a function-level reset on each device after it is unbound from
# its current driver and before the next driver takes it. The kernel only
# exposes the 'reset' sysfs attribute when it has determined a safe reset
# method for that specific device, so no vendor-specific logic is needed.
# This helps clear "device doesn't come back cleanly" and Code 43 issues
# after a VM reboot. Only attempted while the device has no driver bound.
ALLOW_FUNCTION_LEVEL_RESET=true

# Seconds to wait after SIGTERM before escalating to SIGKILL for any
# process still holding a GPU device node open once the display manager
# has been stopped.
PROCESS_KILL_GRACE_PERIOD=10

# Automatically roll back everything this run changed if a step fails
# partway through (e.g. a device refuses to unbind, or a module refuses to
# reload). If false, a failed run instead leaves the system in whatever
# partial state it reached, for manual inspection -- you can still roll it
# back deliberately afterward with 'vfio-toggle.sh rollback'.
AUTO_ROLLBACK=true

# Where to write the (very) detailed log.
LOG_FILE="/var/log/vfio-toggle.log"

# The log is kept as a single, bounded, circular file: once it would
# exceed this size, the oldest content is dropped in place and only the
# most recent bytes are kept. This NEVER creates numbered backup files
# (.1, .2, ...) -- there is always exactly one log file, at LOG_FILE,
# and it never grows past this cap. Minimum value is 10240 (10 KiB).
LOG_MAX_BYTES=1048576

# Where to persist state between a 'bind' and the matching later 'unbind'
# (which driver each device had, which modules were removed, whether the
# display manager was running). Only delete this file by hand if you're
# sure every device is already back on its normal driver.
STATE_FILE="/var/lib/vfio-toggle/state"

# Where to keep the lock file that prevents two copies of this script
# running at once.
LOCK_FILE="/run/vfio-toggle.lock"

# One of: DEBUG, INFO, WARN, ERROR. Everything is always written to
# LOG_FILE regardless of this setting; this only controls how much shows
# up on the console (or pass -v/--verbose on the command line for one run).
LOG_LEVEL="INFO"
